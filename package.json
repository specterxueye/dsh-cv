{
  "name": "dsh-cv",
  "version": "0.5.0",
  "private": true,
  "description": "简历大师（Resume Master）：面向中文求职场景的简历工具集 —— 拷问式建档、按 JD 取舍项目、magicv.art JSON 生成与三重校验（数字溯源 / 改动合规 / 结构）",
  "keywords": [
    "resume",
    "cv",
    "magicv",
    "dsh",
    "agent-skill",
    "job-hunting",
    "chinese"
  ],
  "license": "MIT",
  "author": "specterxueye",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specterxueye/dsh-cv.git"
  },
  "engines": {
    "node": ">=22 <25",
    "dsh": "0.2.0-rc.1"
  },
  "files": [
    "cordis.patch.yml",
    "preset/skills/",
    "preset/prompts/",
    "data/",
    "profile/",
    "docs/安装与使用.md",
    "docs/user-guide.md",
    "docs/工作流.md",
    "docs/公开发布优化计划.md",
    "THIRD-PARTY-NOTICES.md",
    "scripts/build-resume.mjs",
    "scripts/validate-resume.mjs",
    "scripts/audit-facts.mjs",
    "scripts/diff-resume.mjs",
    "scripts/merge-blueprint.mjs",
    "scripts/paths.mjs",
    "scripts/approval.mjs",
    "scripts/install.ps1",
    "scripts/sync-preset.ps1",
    "scripts/render-height.mjs",
    "scripts/render-measure3.cjs",
    "scripts/render-blocks.cjs",
    "scripts/lib/"
  ],
  "type": "commonjs",
  "scripts": {
    "test": "node --test tests/correctness.test.mjs tests/audit.test.mjs tests/installation.test.mjs tests/facts.test.mjs tests/approval.test.mjs",
    "test:browser": "node --test tests/render-safety.test.mjs tests/pagination.test.mjs",
    "check": "node scripts/check.mjs",
    "validate": "node scripts/validate-resume.mjs",
    "audit": "node scripts/audit-facts.mjs",
    "diff": "node scripts/diff-resume.mjs",
    "build": "node scripts/build-resume.mjs",
    "merge-blueprint": "node scripts/merge-blueprint.mjs",
    "smoke": "node scripts/_smoke-test.mjs",
    "measure": "node scripts/render-measure3.cjs",
    "blocks": "node scripts/render-blocks.cjs",
    "render-height": "node scripts/render-height.mjs",
    "paths": "node scripts/paths.mjs"
  },
  "devDependencies": {
    "playwright-core": ">=1.40"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
